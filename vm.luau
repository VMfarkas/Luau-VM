   assert(take(4)=='MC07','Invalid descriptor version')
   handlers={}
   for _=1,word() do
    local name=take(byte())
    assert(not handlers[name],'Duplicate handler')
    local micro={}
    for i=1,byte() do micro[i]=word() end
    handlers[name]=micro
   end
   assert(p==#plain+1,'Trailing descriptor data')
  end,
  fetch=function() assert(handlers,'Missing VM descriptor') end,
  run=function() return true end,
 })
 decodedHandlers=handlers
 return handlers
end
local VM={}
function VM.run(program,environment,budget,hash)
 assert(type(hash)=='function','VM requires bootstrap hash dependency')
 local descriptors=initialize(hash)
 local r,k,pc,steps={},program.constants,1,0
 local stack,sp={},0
 local ins,finished,result
 local function push(v) sp+=1; stack[sp]=v end
 local function pop() assert(sp>0,'Micro stack underflow'); local v=stack[sp]; stack[sp]=nil; sp-=1; return v end
 local micro={}
micro[42318]=function() r[ins[2]]=pop() end
micro[20717]=function() push(k[ins[3]]) end
micro[51618]=function() local name=pop(); push(environment[name]) end
micro[4114]=function() pc=ins[2] end
micro[22794]=function() local b=pop(); local a=pop(); push(a<b) end
micro[64107]=function() local b=pop(); local a=pop(); push(a==b) end
micro[23411]=function() if not pop() then pc=ins[3] end end
micro[50782]=function() local b=pop(); local a=pop(); push(a+b) end
micro[38203]=function() push(r[ins[2]]) end
micro[27423]=function() push(not pop()) end
micro[34874]=function() local b=pop(); local a=pop(); push(a*b) end
micro[63677]=function() push(r[ins[4]]) end
micro[23567]=function() push(r[ins[3]]) end
micro[699]=function() result=pop(); finished=true end
micro[21521]=function() local b=pop(); local a=pop(); push(a/b) end
micro[62454]=function() push(-pop()) end
micro[30440]=function() local value=pop(); local key=pop(); local t=pop(); t[key]=value end
micro[25926]=function() local key=pop(); local t=pop(); push(t[key]) end
micro[13102]=function() local b=pop(); local a=pop(); push(a..b) end
micro[58747]=function() local b=pop(); local a=pop(); push(a%b) end
micro[33401]=function() local arg=pop(); local fn=pop(); push(fn(arg)) end
micro[21471]=function() local b=pop(); local a=pop(); push(a<=b) end
micro[32010]=function() local b=pop(); local a=pop(); push(a^b) end
micro[1311]=function() push({}) end
micro[26740]=function() local b=pop(); local a=pop(); push(a-b) end
 local dispatch={}
 for name,sequence in descriptors do
  local id=assert(program.isa[name],'Missing payload opcode')
  for _,opcode in sequence do assert(micro[opcode],'Unknown micro opcode') end
  dispatch[id]=sequence
 end
 local maxSteps=budget or 10000000
 while true do
  steps+=1; assert(steps<=maxSteps,'Instruction budget exceeded')
  ins=assert(program.code[pc],'Invalid program counter'); pc+=1
  local sequence=assert(dispatch[ins[1]],'Invalid payload opcode')
  for _,id in sequence do micro[id]() end
  assert(sp==0,'Unbalanced micro stack')
  if finished then return result,steps end
 end
end
return VM
