local R=(function()
-- Custom binary container and instruction interpreter. Lune SHA-256 is injected.
local R={}
function R.unhex(h)
    assert(#h%2==0 and not string.find(h,'[^0-9a-fA-F]'),'Invalid hex')
    return (string.gsub(h,'..',function(s) return string.char(tonumber(s,16)) end))
end
function R.u32(s,p)
    local a,b,c,d=string.byte(s,p,p+3)
    assert(d,'Truncated integer')
    return ((a*256+b)*256+c)*256+d
end
function R.pack(v)
    return string.char(bit32.rshift(v,24),bit32.band(bit32.rshift(v,16),255),bit32.band(bit32.rshift(v,8),255),bit32.band(v,255))
end
function R.decode(s,alphabet)
    local base=#alphabet
    assert(base==85 and #s%5==0 and #s>=5,'Invalid radix container')
    local digits={}
    for i=1,base do
        local ch=string.byte(alphabet,i)
        assert(not digits[ch],'Duplicate alphabet symbol')
        digits[ch]=i -- stored +1 to distinguish zero from absence
    end
    local out={}
    for p=1,#s,5 do
        local v=0
        for j=p,p+4 do v=v*base+(assert(digits[string.byte(s,j)],'Invalid radix digit')-1) end
        assert(v<=4294967295,'Radix block overflow')
        out[#out+1]=R.pack(v)
    end
    local raw=table.concat(out)
    local len=R.u32(raw,1)
    assert(len<=#raw-4 and #raw-4-len<=3,'Invalid radix length')
    for i=len+5,#raw do assert(string.byte(raw,i)==0,'Noncanonical radix padding') end
    return string.sub(raw,5,len+4)
end
function R.unwrap(pack)
    return R.decode(pack.data,pack.a85)
end
function R.unmask(data,state,salt,hash)
    local out={}
    for p=1,#data,32 do
        local key=R.unhex(hash('P5'..R.pack(state)..R.pack(salt)..R.pack(math.floor((p-1)/32)+1)))
        for j=0,math.min(31,#data-p) do
            out[#out+1]=string.char(bit32.bxor(string.byte(data,p+j),string.byte(key,j+1)))
        end
    end
    return table.concat(out)
end
function R.execute(pack,key,seed,salt,hash,callbacks)
    assert(pack.count>=3 and pack.count<=500000 and #key==32,'Invalid flow parameters')
    local cipher=R.unwrap(pack)
    assert(#cipher==pack.count*6,'Invalid flow byte length')
    assert(hash(cipher)==pack.digest,'Flow checksum mismatch')
    local dispatch={}
    for n,id in pack.isa do
        assert(id>=1 and id<=65535 and not dispatch[id],'Invalid ISA')
        dispatch[id]=n
    end
    assert(#pack.isa==8,'Invalid ISA size')
    local state,previous=seed,''
    for i=1,pack.count do
        key=R.unhex(hash('I5'..key..R.pack(i)..previous))
        local p=(i-1)*6+1
        local b={}
        for j=1,6 do b[j]=bit32.bxor(string.byte(cipher,p+j-1),string.byte(key,j)) end
        previous=string.char(table.unpack(b))
        local op=assert(dispatch[b[1]*256+b[2]],'Unknown flow opcode')
        local v=((b[3]*256+b[4])*256+b[5])*256+b[6]
        if i<=pack.count-3 then
            if op==1 then state=bit32.bxor(bit32.lrotate(state,5),v)
            elseif op==2 then state=(bit32.lrotate(state,11)+v)%4294967296
            elseif op==3 then state=bit32.bxor(bit32.rrotate(state,7),v,salt)
            elseif op==4 then state=bit32.lrotate(bit32.bxor(state,v),13)
            elseif op==5 then state=(bit32.bnot(state)+v+salt)%4294967296
            else error('Unexpected control opcode') end
        else
            local expected=6+(i-(pack.count-2))
            assert(op==expected and v==0,'Invalid control sequence')
            if op==6 then callbacks.decode(state)
            elseif op==7 then callbacks.fetch()
            else return callbacks.run() end
        end
    end
end
return R

end)()
