local host=(function()
-- Executor filesystem is relative to its own workspace. Lune uses cwd.
local host={}
if type(readfile)=='function' and type(writefile)=='function' then
    assert(type(isfile)=='function' and type(isfolder)=='function' and type(makefolder)=='function','Missing executor filesystem APIs')
    assert(type(crypt)=='table' and type(crypt.hash)=='function','Missing crypt.hash SHA256')
    assert(type(loadstring)=='function','Missing module compiler')
    local send=request or http_request
    if type(send)~='function' and type(syn)=='table' then send=syn.request end
    -- Networking is only required on an actual cache miss.
    host.read=readfile; host.write=writefile; host.isFile=isfile
    host.isDir=isfolder; host.mkdir=makefolder
    host.hash=function(s) return string.lower(crypt.hash(s,'SHA256')) end
    host.download=function(url)
        assert(type(send)=='function','Cache miss: no request API available')
        local r=send({Url=url,Method='GET'})
        assert(type(r)=='table' and r.StatusCode==200,'Module HTTP '..tostring(r and r.StatusCode))
        return assert(r.Body,'Missing response body')
    end
    host.compile=function(source)
        local fn,err=loadstring(source,'verified_module')
        return assert(fn,err)
    end
else
    local fs=require('@lune/fs')
    local net=require('@lune/net')
    local serde=require('@lune/serde')
    local luau=require('@lune/luau')
    host.read=fs.readFile; host.write=fs.writeFile; host.isFile=fs.isFile
    host.isDir=fs.isDir; host.mkdir=fs.writeDir
    host.hash=function(s) return serde.hash('sha256',s) end
    host.download=function(url)
        local r=net.request({url=url,method='GET'})
        assert(r.statusCode==200,'Module HTTP '..r.statusCode)
        return r.body
    end
    host.compile=function(source) return luau.load(source,{debugName='verified_module'}) end
end
assert(host.hash('')=='e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855','SHA256 provider mismatch')
host.warn=warn
return host

end)()
local R=(function()
-- Custom binary container and instruction interpreter. Lune SHA-256 is injected.
local R={}
function R.unhex(h)
    assert(#h%2==0 and not string.find(h,'[^0-9a-fA-F]'),'Invalid hex')
    return (string.gsub(h,'..',function(s) return string.char(tonumber(s,16)) end))
end
function R.u32(s,p)
    local a,b,c,d=string.byte(s,p,p+3)
    assert(d,'Truncated integer')
    return ((a*256+b)*256+c)*256+d
end
function R.pack(v)
    return string.char(bit32.rshift(v,24),bit32.band(bit32.rshift(v,16),255),bit32.band(bit32.rshift(v,8),255),bit32.band(v,255))
end
function R.decode(s,alphabet)
    local base=#alphabet
    assert(base==85 and #s%5==0 and #s>=5,'Invalid radix container')
    local digits={}
    for i=1,base do
        local ch=string.byte(alphabet,i)
        assert(not digits[ch],'Duplicate alphabet symbol')
        digits[ch]=i -- stored +1 to distinguish zero from absence
    end
    local out={}
    for p=1,#s,5 do
        local v=0
        for j=p,p+4 do v=v*base+(assert(digits[string.byte(s,j)],'Invalid radix digit')-1) end
        assert(v<=4294967295,'Radix block overflow')
        out[#out+1]=R.pack(v)
    end
    local raw=table.concat(out)
    local len=R.u32(raw,1)
    assert(len<=#raw-4 and #raw-4-len<=3,'Invalid radix length')
    for i=len+5,#raw do assert(string.byte(raw,i)==0,'Noncanonical radix padding') end
    return string.sub(raw,5,len+4)
end
function R.unwrap(pack)
    return R.decode(pack.data,pack.a85)
end
function R.unmask(data,state,salt,hash)
    local out={}
    for p=1,#data,32 do
        local key=R.unhex(hash('P5'..R.pack(state)..R.pack(salt)..R.pack(math.floor((p-1)/32)+1)))
        for j=0,math.min(31,#data-p) do
            out[#out+1]=string.char(bit32.bxor(string.byte(data,p+j),string.byte(key,j+1)))
        end
    end
    return table.concat(out)
end
function R.execute(pack,key,seed,salt,hash,callbacks)
    assert(pack.count>=3 and pack.count<=500000 and #key==32,'Invalid flow parameters')
    local cipher=R.unwrap(pack)
    assert(#cipher==pack.count*6,'Invalid flow byte length')
    assert(hash(cipher)==pack.digest,'Flow checksum mismatch')
    local dispatch={}
    for n,id in pack.isa do
        assert(id>=1 and id<=65535 and not dispatch[id],'Invalid ISA')
        dispatch[id]=n
    end
    assert(#pack.isa==8,'Invalid ISA size')
    local state,previous=seed,''
    for i=1,pack.count do
        key=R.unhex(hash('I5'..key..R.pack(i)..previous))
        local p=(i-1)*6+1
        local b={}
        for j=1,6 do b[j]=bit32.bxor(string.byte(cipher,p+j-1),string.byte(key,j)) end
        previous=string.char(table.unpack(b))
        local op=assert(dispatch[b[1]*256+b[2]],'Unknown flow opcode')
        local v=((b[3]*256+b[4])*256+b[5])*256+b[6]
        if i<=pack.count-3 then
            if op==1 then state=bit32.bxor(bit32.lrotate(state,5),v)
            elseif op==2 then state=(bit32.lrotate(state,11)+v)%4294967296
            elseif op==3 then state=bit32.bxor(bit32.rrotate(state,7),v,salt)
            elseif op==4 then state=bit32.lrotate(bit32.bxor(state,v),13)
            elseif op==5 then state=(bit32.bnot(state)+v+salt)%4294967296
            else error('Unexpected control opcode') end
        else
            local expected=6+(i-(pack.count-2))
            assert(op==expected and v==0,'Invalid control sequence')
            if op==6 then callbacks.decode(state)
            elseif op==7 then callbacks.fetch()
            else return callbacks.run() end
        end
    end
end
return R

end)()
local decode=(function()
-- Local bytecode container decoder. Returns validated VM input.
local function decode(hex, maxInstructions)
    assert(type(hex)=='string' and #hex<=32000000 and #hex%2==0,'Invalid payload size')
    assert(not string.find(hex,'[^0-9a-fA-F]'),'Invalid hex payload')
    local data=string.gsub(hex,'..',function(s) return string.char(tonumber(s,16)) end)
    local pos=1
    local function take(n)
        assert(pos+n-1<=#data,'Truncated payload')
        local s=string.sub(data,pos,pos+n-1); pos+=n; return s
    end
    local function u8() return string.byte(take(1)) end
    local function uint(n)
        local v=0
        for _=1,n do v=v*256+u8() end
        return v
    end
    assert(take(4)=='LVM2','Invalid signature')
    assert(u8()==1,'Unsupported format version')
    local expected=uint(4)
    local a,b=1,0
    for i=pos,#data do a=(a+string.byte(data,i))%65521; b=(b+a)%65521 end
    assert(b*65536+a==expected,'Payload checksum mismatch')
    local names={'CONST','MOVE','ADD','SUB','MUL','DIV','MOD','POW','NEG','NOT','EQ','LT','LE','CONCAT','NEWTABLE','GETTABLE','SETTABLE','JMP','JFALSE','CALL','RETURN'}
    local isa,reverse={},{}
    for _,name in names do
        local id=uint(2)
        assert(id>0 and not reverse[id],'Invalid ISA mapping')
        isa[name]=id; reverse[id]=name
    end
    local constants={}
    local count=uint(2)
    for i=1,count do constants[i]=take(uint(4)) end
    local n=uint(4)
    assert(n>0 and n<=maxInstructions,'Instruction count limit exceeded')
    assert(#data-pos+1==n*14,'Invalid instruction section size')
    local code={}
    local function reg(v) assert(v>=1 and v<=65535,'Invalid register') end
    local function constant(v) assert(v>=1 and v<=count,'Invalid constant index') end
    local function jump(v) assert(v>=1 and v<=n,'Invalid jump target') end
    for i=1,n do
        local id,a1,b1,c1=uint(2),uint(4),uint(4),uint(4)
        local name=assert(reverse[id],'Unknown opcode')
        if name=='JMP' then jump(a1)
        else
            reg(a1)
            if name=='CONST' then constant(b1)
            elseif name=='CALL' then constant(b1); reg(c1)
            elseif name=='JFALSE' then jump(b1)
            elseif name=='RETURN' or name=='NEWTABLE' then
            else
                reg(b1)
                if name~='MOVE' and name~='NEG' and name~='NOT' then reg(c1) end
            end
        end
        code[i]={id,a1,b1,c1}
    end
    return {isa=isa,reverse=reverse,constants=constants,code=code}
end
return decode

end)()
