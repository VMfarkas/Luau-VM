local config=table.freeze({maxInstructions=500000,maxSteps=10000000,maxModuleBytes=8388608,cacheDirectory='luau_superflow_cache_v06'})
local cacheFactory=(function()
-- Cache factory: verify bytes before compiling both downloads and disk hits.
return function(host,config)
    local root=config.cacheDirectory
    assert(type(root)=='string' and string.match(root,'^[%w_%-]+$'),'Invalid cache directory')
    local function valid(source,digest)
        return type(source)=='string' and #source<=config.maxModuleBytes and host.hash(source)==digest
    end
    return function(url,digest)
        assert(type(digest)=='string' and #digest==64 and not string.find(digest,'[^0-9a-f]'),'Invalid module digest')
        local path=root..'/'..digest..'.luau'
        local source
        local ok,value=pcall(function()
            if host.isFile(path) then return host.read(path) end
            return nil
        end)
        if ok and valid(value,digest) then source=value end
        if source==nil then
            source=host.download(url)
            assert(type(source)=='string' and #source<=config.maxModuleBytes,'Module size limit')
            assert(valid(source,digest),'Module SHA-256 mismatch')
            local saved=pcall(function()
                if not host.isDir(root) then host.mkdir(root) end
                host.write(path,source)
                assert(valid(host.read(path),digest),'Cache write verification failed')
            end)
            if not saved then host.warn('Cache unavailable: using verified downloaded module for this run') end
        end
        -- Compile the verified string, never loadfile(path) after checking another read.
        return host.compile(source)()
    end
end

end)()
